// Verstak backend, real website (not a Claude artifact).
// Agent roles removed as separate UI entities - single assistant via ChatGPT.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  tasks   Task[]
  records Record[]

  @@map("workspaces")
}

model User {
  id         String        @id @default(cuid())
  telegramId BigInt        @unique
  username   String?
  firstName  String?
  lastName   String?
  role       WorkspaceRole @default(MEMBER)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([workspaceId])
  @@map("users")
}

enum TaskProject {
  METALIZM
  PRINTBAR
  SPRINTAMI
  OTHER
}

enum TaskLever {
  SALES
  OPS
  SCALE
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

// Task id is client-generated (frontend does doc(id).set(...)); the POST
// route in routes/tasks.ts upserts by that id.
model Task {
  id          String      @id
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])

  title       String
  description String?
  project     TaskProject @default(OTHER)
  lever       TaskLever?
  status      TaskStatus  @default(NEW)
  dueDate     DateTime?
  checklist   Json?

  // Everything that did not get its own column, ported from the old
  // artifact: dueTime, reminder, links, attachments, chat (per-task thread).
  extra Json?

  createdByAgentKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, status])
  @@map("tasks")
}

// Generic record for the other verstak modules - sales, production,
// finance, documents, regulations, goals - instead of 6 separate models.
model Record {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  module      String
  data        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, module])
  @@map("records")
}
