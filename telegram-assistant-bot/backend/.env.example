# Postgres — на Railway подставляется автоматически, если подключить Postgres-плагин
# к этому сервису (Railway пропишет DATABASE_URL сам).
DATABASE_URL=postgresql://user:password@localhost:5432/verstak

# Тот же токен, что у бота (telegram-assistant-bot/.env → BOT_TOKEN).
# Нужен только для проверки подписи initData, сообщения бот не отправляет.
BOT_TOKEN=

# Тот же Telegram ID владельца, что и OWNER_TELEGRAM_ID у бота.
OWNER_TELEGRAM_ID=

# Свой секрет для подписи сессионных JWT бэкенда — сгенерировать один раз,
# например: openssl rand -hex 32
JWT_SECRET=

PORT=3000

# Через запятую, без пробелов: https://verstak.example.com,https://web.telegram.org
ALLOWED_ORIGINS=

DEFAULT_WORKSPACE_NAME=Мой бизнес
